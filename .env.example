# Application URL (automatically injected in AI Studio preview)
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Frontend Client URL for CORS allowlist (comma-separated if multiple)
CLIENT_URL=http://localhost:3000,http://localhost:5173
VITE_API_URL=

# MongoDB Atlas Connection String (leave blank in local preview to use local JSON store fallback)
MONGODB_URI=

# JWT Signing Secret (generate a strong random string in production)
JWT_SECRET=

# Optional: Pre-configured Initial Admin Credentials (recommended for production)
# If omitted on first run, an inline one-time admin setup screen appears at /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary Configuration (optional; falls back to secure local /uploads storage if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
